rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isTrainee() {
      return isAuthenticated() && getRole() == 'trainee';
    }

    function isFaculty() {
      return isAuthenticated() && getRole() == 'faculty';
    }

    function isAdmin() {
      return isAuthenticated() && getRole() == 'admin';
    }

    function isFacultyOrAdmin() {
      return isAuthenticated() && (getRole() == 'faculty' || getRole() == 'admin');
    }

    // ── Users ─────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Allow user ID queries during login & registration
      allow read: if true;

      // Allow creating user record during registration
      allow create: if isAuthenticated() && isOwner(uid);

      // Users can update their own non-role fields
      allow update: if isAuthenticated() && isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']);

      // Admin can update any user (approving/rejecting faculty)
      allow update: if isAdmin();

      // No deletion (deactivate/reject status only)
      allow delete: if false;
    }

    // ── Live Classes ──────────────────────────────────────────────────────────

    match /liveClasses/{classId} {
      allow read: if isAuthenticated();
      allow write: if isFacultyOrAdmin();
    }

    // ── Courses ───────────────────────────────────────────────────────────────

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isFacultyOrAdmin();
      allow update: if isFacultyOrAdmin();
      allow delete: if isAdmin();

      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isFacultyOrAdmin();
      }
    }

    // ── Quizzes ───────────────────────────────────────────────────────────────

    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isFacultyOrAdmin();
      allow update: if isFacultyOrAdmin();
      allow delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isFacultyOrAdmin();
      }
    }

    // ── Quiz Attempts ─────────────────────────────────────────────────────────

    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.traineeId == request.auth.uid || isFacultyOrAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.traineeId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Resources / Digital Library ────────────────────────────────────────────

    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create: if isFacultyOrAdmin();
      allow update: if isFacultyOrAdmin() ||
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount']));
      allow delete: if isAdmin();
    }

    // ── Categories ────────────────────────────────────────────────────────────

    match /categories/{catId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Announcements ─────────────────────────────────────────────────────────

    match /announcements/{annId} {
      allow read: if isAuthenticated();
      allow create: if isFacultyOrAdmin();
      allow update: if isFacultyOrAdmin();
      allow delete: if isAdmin();
    }

    // ── Timetable ─────────────────────────────────────────────────────────────

    match /timetable/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isFacultyOrAdmin();
    }

    // ── Progress ─────────────────────────────────────────────────────────────

    match /progress/{progressId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // ── Bookmarks ─────────────────────────────────────────────────────────────

    match /bookmarks/{bookmarkId} {
      allow read, create, delete: if isAuthenticated();
    }

    // ── AI Jobs ───────────────────────────────────────────────────────────────

    match /aiJobs/{jobId} {
      allow read, create: if isFacultyOrAdmin();
      allow update: if isAdmin();
    }

    // ── Academy Settings ──────────────────────────────────────────────────────

    match /academySettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
