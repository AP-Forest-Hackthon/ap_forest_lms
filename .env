# Forest Academy E-Center — Environment Configuration
# Copy this file as .env and fill in actual values.
# NEVER commit this file with real secrets to version control.

# ── Python FastAPI Backend URL ────────────────────────────────────────────
# Local development: http://10.0.2.2:8000   (Android emulator → localhost)
# Production (Cloud Run): https://your-cloud-run-url.run.app
BACKEND_BASE_URL=http://10.0.2.2:8000

# ── Google Maps API Key (Android) ─────────────────────────────────────────
# Also set in AndroidManifest.xml <meta-data com.google.android.geo.API_KEY>
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ── App Configuration ─────────────────────────────────────────────────────
APP_NAME=Forest Academy E-Center
APP_ENV=development
2